# DISABLED (aio-01 unreachable):     echo "⚠ Registration script may have completed" >> $LOGFILE
# DISABLED (aio-01 unreachable): fi

echo "=== Boot script completed: $(date) ===" >> $LOGFILE

# BOOT-TIME CACHE CLEANUP (no-root subset)
echo "Cleaning regenerable files..." >> $LOGFILE
rm -rf /sdcard/.thumbnails/* 2>> $LOGFILE
find /sdcard -name '*.tmp' -delete 2>> $LOGFILE
apt-get clean 2>> $LOGFILE
echo "✓ Boot cleanup done" >> $LOGFILE
