# DISABLED (aio-01 unreachable): echo "Starting registration script..." >> $LOGFILE
# DISABLED (aio-01 unreachable): nohup ./worker-register.sh >> ~/worker-register.log 2>&1 &
# DISABLED (aio-01 unreachable): REG_PID=$!
